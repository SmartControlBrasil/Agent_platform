{
  "manifest_version": 3,
  "name": "Agent Platform Executor",
  "version": "0.1.0",
  "description": "Chrome executor for Agent Platform delegated tool executions.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "background": {
    "service_worker": "src/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Agent Executor",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://livia.smartcontrolbrasil.com.br/*",
    "https://*.smartcontrolbrasil.com.br/*"
  ],
  "host_permissions": [
    "https://www.google.com/maps*",
    "https://www.google.com/maps/*"
  ]
}
